{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "paths": {
      "@pm/ids": ["./packages/pm-ids/src"],
      "@pm/ids/*": ["./packages/pm-ids/src/*"],
      "@pm/geometry": ["./packages/pm-geometry/src"],
      "@pm/geometry/*": ["./packages/pm-geometry/src/*"],
      "@pm/materials": ["./packages/pm-materials/src"],
      "@pm/materials/*": ["./packages/pm-materials/src/*"],
      "@pm/design": ["./packages/pm-design/src"],
      "@pm/design/*": ["./packages/pm-design/src/*"],
      "@pm/project": ["./packages/pm-project/src"],
      "@pm/project/*": ["./packages/pm-project/src/*"],
      "@pm/analysis": ["./packages/pm-analysis/src"],
      "@pm/analysis/*": ["./packages/pm-analysis/src/*"],
      "@pm/equivalent-block": ["./packages/pm-equivalent-block/src"],
      "@pm/equivalent-block/*": ["./packages/pm-equivalent-block/src/*"],
      "@pm/code-kds142020": ["./packages/pm-code-kds142020/src"],
      "@pm/code-kds142020/*": ["./packages/pm-code-kds142020/src/*"],
      "@pm/code-aci318": ["./packages/pm-code-aci318/src"],
      "@pm/code-aci318/*": ["./packages/pm-code-aci318/src/*"],
      "@pm/report": ["./packages/pm-report/src"],
      "@pm/report/*": ["./packages/pm-report/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

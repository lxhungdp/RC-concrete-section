{
  "name": "pm-column-designer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Modular web platform for reinforced concrete column P-M-M section design.",
  "homepage": "https://pmcurve.vercel.app/",
  "scripts": {
    "dev": "npm run dev -w @pm/web",
    "start": "npm run start -w @pm/web",
    "build": "npm run build -w @pm/web",
    "check:web-bundle": "node tools/performance/check-web-bundle.mjs",
    "lint": "npm run typecheck",
    "check:structure": "tsx tools/architecture/check-repository-layout.ts",
    "check:security": "npm audit --omit=dev --audit-level=high",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:structure && npm run typecheck && npm run test:unit && npm run test:cad && npm run test:roundtrip && npm run test:pm-stations && npm run test:excel-export && npm run test:excel-block && npm run test:demand-check && npm run test:pdf-report",
    "test:unit": "node --import tsx --test packages/pm-results/test/*.test.ts packages/pm-equivalent-block/test/*.test.ts packages/pm-code-kds142020/test/*.test.ts packages/pm-code-aci318/test/*.test.ts packages/pm-code-en1992/test/*.test.ts packages/pm-code-as3600/test/*.test.ts packages/pm-code-custom/test/*.test.ts packages/pm-project/test/*.test.ts packages/pm-analysis-equivalent-block/test/*.test.ts packages/pm-analysis/test/*.test.ts packages/pm-report/test/*.test.ts apps/web/test/*.test.ts apps/web/test/analysis/*.test.ts apps/web/test/geometry/*.test.ts apps/web/test/results/*.test.ts",
    "test:cad": "npm run test -w @structures/cad-drawing",
    "test:roundtrip": "tsx packages/pm-project/test/integration/roundtrip.selftest.ts",
    "test:pm-stations": "tsx packages/pm-analysis/test/integration/analysis.selftest.ts",
    "test:excel-export": "tsx packages/pm-report/test/integration/excel.selftest.ts",
    "fixture:reference-json": "tsx packages/pm-analysis/test/fixtures/write-reference-case.ts",
    "bench": "tsx packages/pm-analysis/bench/run.ts",
    "bench:materials": "tsx packages/pm-analysis/bench/material.ts",
    "bench:mesh": "tsx packages/pm-analysis/bench/mesh.ts",
    "bench:equivalent-block": "tsx bench/equivalent-block/run.ts",
    "bench:pipelines": "tsx bench/cross-model/pipeline-comparison.ts",
    "bench:strain-sampling": "tsx bench/stress-strain/strain-domain-sampling.ts",
    "bench:sampling-modes": "tsx bench/sampling-modes.ts",
    "bench:record": "tsx packages/pm-analysis/bench/run.ts --repeats 1 --fingerprint-out packages/pm-analysis/bench/baselines/capacity-baseline.json",
    "bench:verify": "tsx packages/pm-analysis/bench/run.ts --repeats 1 --baseline packages/pm-analysis/bench/baselines/capacity-baseline.json",
    "test:excel-block": "tsx packages/pm-report/test/integration/equivalent-block.selftest.ts",
    "test:demand-check": "tsx packages/pm-report/test/integration/demand-check.selftest.ts",
    "test:pdf-report": "tsx packages/pm-report/test/integration/pdf-report.selftest.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@jscad/regl-renderer": "2.6.15",
    "exceljs": "4.4.0",
    "gl-mat4": "1.2.0",
    "gl-vec3": "1.2.0",
    "jszip": "3.10.1",
    "lucide-react": "1.25.0",
    "next": "16.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "hyperformula": "3.3.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@11.5.0"
}
